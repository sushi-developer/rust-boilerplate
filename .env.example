# ── Server ──
# One of: local, staging, production. `local` starts with empty Postgres and Redis container.
ENVIRONMENT=local
PORT=3000
TRACE_LEVEL=info
PUBLIC_BASE_URL=http://localhost:3000 # Base URL for the OpenAPI `servers` list.

# ── Postgres (required unless ENVIRONMENT=local) ──
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5432/app
DB_MAX_CONNECTION=5

# ── Redis (required unless ENVIRONMENT=local) ──
REDIS_URL=redis://127.0.0.1:6379

# ── Rate limiting (production only) ──
# One token for one request. One token is replenished every RATE_LIMIT_PER_SECOND seconds;
# RATE_LIMIT_BURST is the token bucket for each IP.
RATE_LIMIT_PER_SECOND=10
RATE_LIMIT_BURST=30
